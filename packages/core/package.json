{
  "name": "compass-fe-observe-sdk",
  "version": "0.1.2",
  "description": "Lightweight frontend observability SDK for web applications.",
  "homepage": "https://github.com/Shaoyi23/fe-observe-sdk#readme",
  "bugs": {
    "url": "https://github.com/Shaoyi23/fe-observe-sdk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shaoyi23/fe-observe-sdk.git"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "observability",
    "monitoring",
    "frontend",
    "browser",
    "sdk",
    "performance",
    "errors"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
